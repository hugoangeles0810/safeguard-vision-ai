*.mp4
*.avi
*.mov
*.mkv

# Keep directory structure
!data/raw/.gitkeep
!data/raw/ur_fall/.gitkeep
!data/raw/le2i/.gitkeep

# Processed data (can be regenerated)
data/processed/**
!data/processed/.gitkeep

# Model checkpoints (large files)
results/checkpoints/**
!results/checkpoints/.gitkeep

# Logs
results/logs/**
!results/logs/.gitkeep

# Figures (can be regenerated)
results/figures/**
!results/figures/.gitkeep

